# ==============================================================================
# CHANNELBASE — Environment configuration
# Copy this file to .env and fill in what you have. Anything left blank falls
# back to a clearly-labeled MOCK provider so the app runs fully offline.
# ==============================================================================

# ---- Core -------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000

# JWT signing secret for API auth sessions. Generate with: openssl rand -hex 32
JWT_SECRET=dev-jwt-secret-change-me-please-32chars-min

# AES-256 key used to encrypt PlatformAccount OAuth tokens at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=dev-encryption-key-change-me-32bytes!!

# ---- Database -----------------------------------------------------------------
DATABASE_URL="postgresql://channelbase:channelbase@localhost:5432/channelbase?schema=public"

# ---- Redis / Queue ------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---- Storage --------------------------------------------------------------
# STORAGE_DRIVER: "local" | "s3". Defaults to "local" (writes under ./storage/local)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage/local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# ---- LLM Provider -----------------------------------------------------------
# LLM_PROVIDER: "anthropic" | "openai" | "mock". Defaults to "mock" if no key set.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# ---- Image Provider -----------------------------------------------------------
# IMAGE_PROVIDER: "openai" | "stability" | "mock". "openai" uses gpt-image-1 (real
# adapter implemented in packages/providers/src/image/openai.ts); "stability" is a
# documented stub only.
IMAGE_PROVIDER=mock
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1

# ---- Video Provider -----------------------------------------------------------
# VIDEO_PROVIDER: "runway" | "luma" | "mock". "runway" is a real adapter (image-to-video,
# see packages/providers/src/video/runway.ts) — it requires a source image per scene,
# which the pipeline supplies automatically from that scene's generated IMAGE asset.
# "luma" is a documented stub only.
VIDEO_PROVIDER=mock
VIDEO_API_KEY=
VIDEO_MODEL=gen4_turbo

# ---- Voice / TTS Provider -------------------------------------------------------
# VOICE_PROVIDER: "elevenlabs" | "mock". "elevenlabs" is a real adapter (see
# packages/providers/src/voice/elevenlabs.ts).
VOICE_PROVIDER=mock
VOICE_API_KEY=
VOICE_MODEL=eleven_multilingual_v2

# ---- Music Provider -----------------------------------------------------------
# MUSIC_PROVIDER: "mock" (no widely-available production API at time of writing)
MUSIC_PROVIDER=mock
MUSIC_API_KEY=

# ---- Publishing: YouTube -------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4000/auth/youtube/callback

# ---- Publishing: other platforms (adapters exist, disabled until configured) ---
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---- Billing --------------------------------------------------------------
# BILLING_PROVIDER: "stripe" | "mock". Defaults to "mock".
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Auth: Google OAuth (web login) -----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Feature flags ----------------------------------------------------------
FEATURE_YOUTUBE_PUBLISHING=false
FEATURE_AUTOPILOT=false
FEATURE_ANALYTICS=true
FEATURE_REAL_VIDEO_GENERATION=false
FEATURE_REAL_IMAGE_GENERATION=false

# ---- Observability ----------------------------------------------------------
LOG_LEVEL=info
